# ───────────────────────────────────────────────────────────────────────────
# Supabase (Company Brain cloud mode)
# ───────────────────────────────────────────────────────────────────────────
# From https://app.supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Bypasses RLS for engine writes
# (Inngest functions, seed scripts, the connector token exchange).
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────────────────────────────────────────────────────────────────
# OpenAI (embeddings + brain agent)
# ───────────────────────────────────────────────────────────────────────────
# text-embedding-3-small for brain_pages / brain_timeline embedding writes;
# gpt-4o for the /api/brain/agent agentic RAG endpoint.
OPENAI_API_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Inngest (background jobs — sync, embedding, mining)
# ───────────────────────────────────────────────────────────────────────────
# Local dev: run `npx inngest-cli dev` and these can stay blank.
# Production: from https://app.inngest.com → your app → Manage → Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Source connectors (OAuth + API tokens)
# ───────────────────────────────────────────────────────────────────────────
# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Slack API
SLACK_BOT_TOKEN=

# Linear API
LINEAR_API_KEY=

# Google Calendar API (shares credentials with Gmail)
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REFRESH_TOKEN=

# Email delivery (for weekly report)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_TO_EMAIL=
REPORT_FROM_EMAIL=
