{
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter web build",
  "crons": [
    {
      "path": "/api/cron/sync-and-mine",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/digest?cron=true",
      "schedule": "0 9 * * 1"
    }
  ]
}
