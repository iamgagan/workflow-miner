# Workflow Miner desktop app — environment variables
#
# Copy this file to apps/desktop/.env.local before running `pnpm desktop:dev`
# or building the production .dmg. None of these are required to launch the
# app, but Google connectors will be unavailable until the OAuth client is
# configured.
#
# Where to get values
# -------------------
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth client of type "Desktop application"
#    (Web application also works, but you must register
#    http://127.0.0.1 as an authorized redirect URI — Desktop type
#    handles this automatically.)
# 3. Enable Gmail API and Google Calendar API on the project.
# 4. Copy the client ID + secret here.

# Bundled Google OAuth client (required for Gmail + Calendar connectors)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Same client ID exposed to the renderer so the OAuth loopback flow can
# build the authorize URL on the client side. Safe to expose because it's
# a "public" installed-app client.
NEXT_PUBLIC_GMAIL_CLIENT_ID=

# OpenRouter API key (required for chat coach + nudges + digest summaries)
OPEN_ROUTER_API_KEY=

# Override the local PGlite data directory. Defaults to:
#   macOS:   ~/Library/Application Support/WorkflowMiner/brain
#   Windows: %APPDATA%/WorkflowMiner/brain
#   Linux:   $XDG_DATA_HOME/workflow-miner/brain
# WORKFLOW_MINER_DATA_DIR=

# Force desktop mode in the Next.js process. The Tauri shell sets this
# automatically when launching the sidecar; only needed if you want to test
# the local-shim path standalone via `next dev`.
# WORKFLOW_MINER_MODE=desktop
