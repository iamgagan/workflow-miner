# Tauri / Rust build artefacts.
# Cargo.lock IS committed for this crate (binary / app crate) so every
# developer and CI job gets the same dependency resolutions — see the
# Cargo book, https://doc.rust-lang.org/cargo/faq.html#why-have-cargolock-in-version-control
src-tauri/target/
src-tauri/gen/

# Bundled Next.js standalone output (regenerated by build-next.mjs).
# We keep the directory checked in (via .gitkeep) so Tauri's resource
# path validator is happy during `cargo check` / `tauri dev` before
# build-next.mjs has run. The contents are ignored.
resources/next/*
!resources/next/.gitkeep

# Local env
.env.local
.env

# Generated Tauri capabilities (if any)
src-tauri/capabilities/.generated/
